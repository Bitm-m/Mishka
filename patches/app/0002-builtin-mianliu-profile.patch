+        const val BUILTIN_MIANLIU_KEY = "mianliu_imported"
+        const val BUILTIN_MIANLIU_ID_KEY = "mianliu_subscription_id"
+        const val BUILTIN_MIANLIU_RESTORED = "内置「免流」配置已自动恢复"
+    }
