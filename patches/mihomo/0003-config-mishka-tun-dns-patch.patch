From 38490bb64f4e5bb264053446f02d6bf57585f792 Mon Sep 17 00:00:00 2001
From: Mishka Custom Build <custom@localhost>
Date: Thu, 1 Oct 2026 09:40:03 +0000
Subject: [PATCH] config: add mishka Android patch behind the mishka build tag

Ports YuKongA's addd66b + 4c724df: a config-level hook plus
config/patch_mishka.go (both `//go:build mishka`) that adapts a
subscription's RawConfig for Android usage.

* DNS disabled -> inject fake-ip defaults (domestic + intl nameservers,
  28.0.0.0/8, the STUN / console / captive-portal filter list), because
  dns-hijack leaves no responder behind on Android.
* VPN mode (FileDescriptor > 0) -> append `system://` to the nameservers
  when AppendSystemDNS is set, as a last-resort fallback.
* VPN mode -> rebuild cfg.Tun from a whitelist of fields that the fd code
  path supports, dropping Linux-only keys (auto-redirect, iproute2-*,
  include-uid, route-address, ...) that would otherwise crash sing-tun.
* Neither external-ui nor external-ui-name set -> inject external-ui "ui"
  so the kernel mounts and serves /ui for the in-app external panel
  WebView (a bare 404 -> blank page otherwise), and swap the stock
  github.com download URL for a gh-proxy mirrored zashboard build when
  the user has not explicitly picked one (AutoDownloadUI fetches it
  once into the config dir; failures are logged only).

The hook variable itself lives outside the build tag so upstream files
stay compilable without mishka.

https://github.com/YuKongA/mihomo/commit/addd66b
https://github.com/YuKongA/mihomo/commit/4c724df
---
 config/config.go            |  1 +
 config/patch_mishka.go      | 91 +++++++++++++++++++++++++++++++++++++++++++++
 config/patch_mishka_noop.go |  5 +++
 3 files changed, 97 insertions(+)

diff --git a/config/config.go b/config/config.go
index 7e4ea9cd1216d0a6daf4c688c9fd57fd0f7509a4..1a70f53cb3dbcaef12e0ab4753cb4f1484666be5 100644
--- a/config/config.go
+++ b/config/config.go
@@ -495,6 +495,7 @@ func Parse(buf []byte) (*Config, error) {
 	}
 
 	applyOverrideJSON(rawCfg)
+	patchMishka(rawCfg)
 
 	return ParseRawConfig(rawCfg)
 }
diff --git a/config/patch_mishka.go b/config/patch_mishka.go
new file mode 100644
index 0000000000000000000000000000000000000000..df6bbc6baeb373ead6a66e11ffaccafe702832dc
--- /dev/null
+++ b/config/patch_mishka.go
@@ -0,0 +1,91 @@
+//go:build mishka
+
+package config
+
+import (
+	"slices"
+
+	C "github.com/metacubex/mihomo/constant"
+)
+
+// DefaultRawConfig 的 DNS 全部留空，缺 dns: 段的精简订阅在 TUN dns-hijack 下无法解析任何域名。
+// 对齐 CMFA patchAndroidConfig 的兜底逻辑（由 --tags mishka 独立承载，避免引入 cmfa tag 对
+// component/dialer 等处的副作用）：当用户与订阅都未开启 DNS 时，注入默认公网 DoH + fake-ip。
+var mishkaDefaultNameServers = []string{
+	"223.5.5.5",
+	"119.29.29.29",
+	"https://223.5.5.5/dns-query",
+	"https://120.53.53.53/dns-query",
+}
+
+const mishkaDefaultFakeIPRange = "198.18.0.1/16"
+
+var mishkaDefaultFakeIPFilter = []string{
+	"*.lan",
+	"*.local",
+	"time.*.com",
+	"ntp.*.com",
+	"+.market.xiaomi.com",
+	"localhost.ptlogin2.qq.com",
+	"+.msftncsi.com",
+	"www.msftconnecttest.com",
+}
+
+// DefaultRawConfig 把 ExternalUIURL 硬编码为 MetaCubeX/metacubexd 的原版地址（见 config.go），
+// 订阅未写 external-ui-url 时 rawCfg 里也已经有这个非空值；用同一常量识别「未由订阅显式指定」。
+const (
+	mishkaStockExternalUIURL   = "https://github.com/MetaCubeX/metacubexd/archive/refs/heads/gh-pages.zip"
+	mishkaDefaultExternalUIURL = "https://github.com/jieluojun/metacubexd/archive/refs/heads/gh-pages.zip"
+)
+
+func patchMishka(cfg *RawConfig) {
+	if !cfg.DNS.Enable {
+		cfg.DNS = DefaultRawConfig().DNS
+		cfg.DNS.Enable = true
+		cfg.DNS.NameServer = mishkaDefaultNameServers
+		cfg.DNS.EnhancedMode = C.DNSFakeIP
+		cfg.DNS.FakeIPRange = mishkaDefaultFakeIPRange
+		cfg.DNS.FakeIPFilter = mishkaDefaultFakeIPFilter
+		cfg.ClashForAndroid.AppendSystemDNS = true
+	}
+	if cfg.ClashForAndroid.AppendSystemDNS && !slices.Contains(cfg.DNS.NameServer, "system://") && !slices.Contains(cfg.DNS.NameServer, "system") {
+		cfg.DNS.NameServer = append(cfg.DNS.NameServer, "system://")
+	}
+
+	// ROOT 模式（fd == 0）走 mihomo TUN（netlink + tun.New()）路径。
+	if cfg.Tun.FileDescriptor > 0 {
+		cfg.Interface = ""
+		cfg.RoutingMark = 0
+		cfg.ExternalControllerTLS = ""
+		cfg.Listeners = slices.DeleteFunc(cfg.Listeners, func(mapping map[string]any) bool {
+			switch mapping["type"] {
+			case "tun", "tproxy", "redir":
+				return true
+			default:
+				return false
+			}
+		})
+		// 白名单外的所有 RawTun 字段归零（包括 CongestionController）。
+		cfg.Tun = RawTun{
+			Enable:              cfg.Tun.Enable,
+			Device:              cfg.Tun.Device,
+			Stack:               cfg.Tun.Stack,
+			DNSHijack:           cfg.Tun.DNSHijack,
+			AutoRoute:           cfg.Tun.AutoRoute,
+			AutoDetectInterface: cfg.Tun.AutoDetectInterface,
+			Inet6Address:        cfg.Tun.Inet6Address,
+			MTU:                 cfg.Tun.MTU,
+			FileDescriptor:      cfg.Tun.FileDescriptor,
+		}
+	}
+
+	// 未配置 external-ui 时给一个默认静态目录与下载源，避免用户进 Web 面板看到 404。
+	// 订阅或覆写显式写了 external-ui / external-ui-name / 自定义 external-ui-url 时完全不动。
+	if cfg.ExternalUI == "" && cfg.ExternalUIName == "" {
+		cfg.ExternalUI = "ui"
+		// 下载地址仅替换「还是内置默认值」的情况；订阅自带 external-ui-url 则保留。
+		if cfg.ExternalUIURL == "" || cfg.ExternalUIURL == mishkaStockExternalUIURL {
+			cfg.ExternalUIURL = mishkaDefaultExternalUIURL
+		}
+	}
+}
diff --git a/config/patch_mishka_noop.go b/config/patch_mishka_noop.go
new file mode 100644
index 0000000000000000000000000000000000000000..faad705eee033521b7239866bfd347e59f4ab55c
--- /dev/null
+++ b/config/patch_mishka_noop.go
@@ -0,0 +1,5 @@
+//go:build !mishka
+
+package config
+
+func patchMishka(_ *RawConfig) {}
