 func (l *Listener) buildAndroidRules(tunOptions *tun.Options) error {
+	// TUN handed in as an fd (Android VpnService) already has its routes set up by the Kotlin
+	// side, so sing-tun must not build them again; package filtering is done by the VPN builder.
+	if tunOptions.FileDescriptor > 0 {
+		return nil
+	}
+	if len(tunOptions.IncludePackage) == 0 && len(tunOptions.ExcludePackage) == 0 {
+		return nil
+	}
 	packageManager, err := getPackageManager()
 	if err != nil {
 		return err
@@ -78,7 +85,8 @@ func findPackageName(metadata *constant.Metadata) (string, error) {
 }
 
 func init() {
-	if !features.CMFA {
-		process.DefaultPackageNameResolver = findPackageName
-	}
+	// Mishka always wants the uid -> package-name resolver: rules match on process names and
+	// the app does not use CMFA's package-name injection, which is why features.CMFA used to
+	// gate this off under the cmfa build tag.
+	process.DefaultPackageNameResolver = findPackageName
 }
diff --git a/listener/sing_tun/server_mishka_android.go b/listener/sing_tun/server_mishka_android.go
new file mode 100644
index 0000000000000000000000000000000000000000..dd3bdbe1c3078ea63727a422d64b3e63de571964
--- /dev/null
+++ b/listener/sing_tun/server_mishka_android.go
@@ -0,0 +1,25 @@
+//go:build mishka
+
+package sing_tun
+
+import (
+	tun "github.com/metacubex/sing-tun"
+	"golang.org/x/sys/unix"
+)
+
+// fd 是 runtime 的稳定来源，listener 只持有副本；重建栈不能关掉下一次 reload 要用的 fd。
+func tunNew(options tun.Options) (tun.Tun, error) {
+	if options.FileDescriptor == 0 {
+		return tun.New(options)
+	}
+	fd, err := unix.FcntlInt(uintptr(options.FileDescriptor), unix.F_DUPFD_CLOEXEC, 0)
+	if err != nil {
+		return nil, err
+	}
+	options.FileDescriptor = fd
+	device, err := tun.New(options)
+	if err != nil {
+		_ = unix.Close(fd)
+	}
+	return device, err
+}
diff --git a/listener/sing_tun/server_mishka_android_test.go b/listener/sing_tun/server_mishka_android_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..7adfd5c41f300d25a16dc11e73382069b013b304
--- /dev/null
+++ b/listener/sing_tun/server_mishka_android_test.go
@@ -0,0 +1,36 @@
+//go:build mishka
+
+package sing_tun
+
+import (
+	"io"
+	"os"
+	"testing"
+
+	tun "github.com/metacubex/sing-tun"
+)
+
+func TestVPNTUNRecreationKeepsSourceDescriptor(t *testing.T) {
+	reader, writer, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer reader.Close()
+	defer writer.Close()
+	for _, value := range []byte{1, 2} {
+		device, err := tunNew(tun.Options{FileDescriptor: int(reader.Fd())})
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := device.Close(); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := writer.Write([]byte{value}); err != nil {
+			t.Fatalf("listener close invalidated runtime fd: %v", err)
+		}
+		var got [1]byte
+		if _, err := io.ReadFull(reader, got[:]); err != nil || got[0] != value {
+			t.Fatalf("runtime fd after recreation: got=%v err=%v", got, err)
+		}
+	}
+}
