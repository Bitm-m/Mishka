From 63c809e9ac2db76f8d2dcc85989629e2236087d3 Mon Sep 17 00:00:00 2001
From: Mishka Custom Build <custom@localhost>
Date: Thu, 1 Oct 2026 09:39:55 +0000
Subject: [PATCH] config: allow the host app to override RawConfig from a JSON
 file

Mishka's mishka_core/runtime.go sets config.OverrideJSONPath from its
--override-json option and expects config.Parse() to merge that file into
the parsed RawConfig. YuKongA's mihomo fork carries this (ceafd04); the
upstream Alpha branch does not, so port it here as a tiny standalone hunk.

A missing / malformed override file only logs a warning: it is a runtime
input provided by the host and must not make the core fail to start.
---
 config/config.go | 30 ++++++++++++++++++++++++++++++
 1 file changed, 30 insertions(+)

diff --git a/config/config.go b/config/config.go
index b17b98d825a5ce84d233dc346812a2ec00e04ca3..7e4ea9cd1216d0a6daf4c688c9fd57fd0f7509a4 100644
--- a/config/config.go
+++ b/config/config.go
@@ -1,11 +1,13 @@
 package config
 
 import (
+	"encoding/json"
 	"errors"
 	"fmt"
 	"net"
 	"net/netip"
 	"net/url"
+	"os"
 	"path/filepath"
 	"strings"
 	"time"
@@ -480,6 +482,11 @@ type RawConfig struct {
 	ClashForAndroid RawClashForAndroid `yaml:"clash-for-android" json:"clash-for-android"`
 }
 
+// OverrideJSONPath points to an optional JSON file whose fields override the parsed RawConfig.
+// Set by the host application before Parse/ParseWithBytes (the Mishka Android app sets it from
+// its --override-json runtime option, see mishka_core/runtime.go).
+var OverrideJSONPath string
+
 // Parse config
 func Parse(buf []byte) (*Config, error) {
 	rawCfg, err := UnmarshalRawConfig(buf)
@@ -487,9 +494,32 @@ func Parse(buf []byte) (*Config, error) {
 		return nil, err
 	}
 
+	applyOverrideJSON(rawCfg)
+
 	return ParseRawConfig(rawCfg)
 }
 
+// applyOverrideJSON merges the JSON file named by OverrideJSONPath into rawCfg.
+// Field names follow the existing `json:` tags of RawConfig. A missing or malformed file only
+// logs a warning: the override is a host-provided runtime input and must not keep the core
+// from starting (the app shows the parse error of the subscription itself instead).
+func applyOverrideJSON(rawCfg *RawConfig) {
+	if OverrideJSONPath == "" {
+		return
+	}
+	data, err := os.ReadFile(OverrideJSONPath)
+	if err != nil {
+		log.Warnln("Read override.json failed: %s", err.Error())
+		return
+	}
+	if len(data) == 0 {
+		return
+	}
+	if err := json.Unmarshal(data, rawCfg); err != nil {
+		log.Warnln("Apply override.json failed: %s", err.Error())
+	}
+}
+
 func DefaultRawConfig() *RawConfig {
 	return &RawConfig{
 		AllowLan:           false,
