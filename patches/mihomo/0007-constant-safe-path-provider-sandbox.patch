From 910ea4c9f32e1ee97ec0ed2c0e588621b0d45ed7 Mon Sep 17 00:00:00 2001
From: Mishka Custom Build <custom@localhost>
Date: Thu, 8 Oct 2026 08:20:40 +0000
Subject: [PATCH] constant: accept the host's provider sandbox as a safe path

Mishka validates a subscription in a singleton sandbox under
files/mihomo/processing/ and points file-backed proxy providers at
processing/providers/<name> in memory (patchProvidersPath). That directory
is outside the geodata home directory, so IsSafePath rejects it whenever
the cmfa tag is absent. Mishka builds mihomo without cmfa on purpose (see
the app patch: CMFA would skip the Linux uid lookup that PROCESS-NAME rules
need), so the import check failed with 'path is not subpath of home
directory or SAFE_PATHS'.

Add an optional host hook, ExtraSafePathFunc, consulted only after the
home-directory and SAFE_PATHS checks fail. Nil by default, so upstream
behaviour is unchanged. The Mishka core installs a hook that accepts only
processing/providers/ next to the home directory.
---
 constant/path.go            |  7 ++++++-
 constant/path_extra_test.go | 24 ++++++++++++++++++++++++
 2 files changed, 30 insertions(+), 1 deletion(-)

diff --git a/constant/path.go b/constant/path.go
index fdc1a15a69f46374a6dc4893ea097921a01c8fd5..0c0906a988e09834e8a4d90473f7f31e5cef1016 100644
--- a/constant/path.go
+++ b/constant/path.go
@@ -85,6 +85,11 @@ func (p *path) Resolve(path string) string {
 	return path
 }
 
+// ExtraSafePathFunc lets the embedding host accept paths that are outside the home directory
+// and SAFE_PATHS. It is consulted only after those checks fail, with the resolved path, and is
+// nil unless the host sets it (Mishka's native core does, for its own provider sandbox).
+var ExtraSafePathFunc func(path string) bool
+
 // IsSafePath return true if path is a subpath of homedir (or in the SAFE_PATHS environment variable)
 func (p *path) IsSafePath(path string) bool {
 	if p.allowUnsafePath || features.CMFA {
@@ -98,7 +103,7 @@ func (p *path) IsSafePath(path string) bool {
 			}
 		}
 	}
-	return false
+	return ExtraSafePathFunc != nil && ExtraSafePathFunc(path)
 }
 
 func (p *path) SafePaths() []string {
diff --git a/constant/path_extra_test.go b/constant/path_extra_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..1dae7e4e39c36f2d67f49d02c76ebc8f47f55f4a
--- /dev/null
+++ b/constant/path_extra_test.go
@@ -0,0 +1,24 @@
+package constant
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+)
+
+func TestExtraSafePathFunc(t *testing.T) {
+	defer func(f func(string) bool) { ExtraSafePathFunc = f }(ExtraSafePathFunc)
+
+	p := &path{homeDir: "/data/files/mihomo/geodata"}
+	sandbox := "/data/files/mihomo/processing/providers/"
+
+	ExtraSafePathFunc = nil
+	assert.False(t, p.IsSafePath(sandbox+"abc"))
+
+	ExtraSafePathFunc = func(path string) bool { return strings.HasPrefix(path, sandbox) }
+	assert.True(t, p.IsSafePath(sandbox+"abc"))
+	assert.True(t, p.IsSafePath("/data/files/mihomo/geodata/GeoIP.dat"))
+	assert.False(t, p.IsSafePath("/data/files/mihomo/processing/other"))
+	assert.False(t, p.IsSafePath("/etc/passwd"))
+}
